  {
    "type": "group",
    "label": {
      "en": "Capabilities"
    },
    "children": [
      {
        "id": "show_diagnostics",
        "type": "checkbox",
        "label": {
          "en": "Show diagnostic capabilities",
          "nl": "Diagnostische capabilities tonen"
        },
        "value": false,
        "hint": {
          "en": "Adds diagnostic entities such as signal strength and uptime. Turning off removes them again.",
          "nl": "Voegt diagnostische capabilities toe, zoals signaalsterkte en uptime. Uitschakelen verwijdert ze weer."
        }
      },
      {
        "id": "show_configuration",
        "type": "checkbox",
        "label": {
          "en": "Show configuration capabilities",
          "nl": "Configuratie-capabilities tonen"
        },
        "value": false,
        "hint": {
          "en": "Adds configuration entities such as calibration numbers and restart buttons. Turning off removes them again.",
          "nl": "Voegt configuratie-capabilities toe, zoals kalibratienummers en herstartknoppen. Uitschakelen verwijdert ze weer."
        }
      }
    ]
  },
