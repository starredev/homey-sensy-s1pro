{
  "name": "io.github.starredev.sensys1pro",
  "version": "1.0.0",
  "description": "Homey app for the Sensy-One S1 Pro Multi Sense mmWave presence sensor",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Bryan",
  "repository": {
    "type": "git",
    "url": "https://github.com/starredev/homey-sensy-s1pro.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "patch-package",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "npx --yes --package=typescript@5 tsc --project jsconfig.json",
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"lib/**/*.js\" --test-coverage-include=\"web/**/*.js\" --test-coverage-lines=85 --test-coverage-branches=80 --test-coverage-functions=85 \"test/**/*.test.js\"",
    "sync:web": "node scripts/sync-web.js",
    "validate": "homey app validate --level publish",
    "check": "npm run lint && npm run typecheck && npm run sync:web:check && npm run test:coverage && npm run validate",
    "sync:web:check": "node scripts/sync-web.js --check"
  },
  "dependencies": {
    "@2colors/esphome-native-api": "^1.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^65.1.0",
    "globals": "^17.13.0",
    "patch-package": "^8.0.1"
  }
}
