    "children": [
      {
        "id": "detection_range",
        "type": "number",
        "label": {
          "en": "Detection range",
          "nl": "Detectiebereik"
        },
        "value": 600,
        "min": 0,
        "max": 1800,
        "units": {
          "en": "cm"
        }
      },
      {
        "id": "any_presence_delay",
        "type": "number",
        "label": {
          "en": "Presence hold time",
          "nl": "Aanwezigheid vasthouden"
        },
        "hint": {
          "en": "How long presence stays on after the last detection.",
          "nl": "Hoe lang aanwezigheid aan blijft na de laatste detectie."
        },
        "value": 0,
        "min": 0,
        "max": 3600,
        "units": {
          "en": "s"
        }
      },
      {
        "id": "any_movement_threshold",
        "type": "number",
        "label": {
          "en": "Movement threshold",
          "nl": "Bewegingsdrempel"
        },
        "hint": {
          "en": "Minimum speed that counts as movement.",
          "nl": "Minimale snelheid die als beweging telt."
        },
        "value": 0,
        "min": 0,
        "max": 5000,
        "units": {
          "en": "cm/s"
        }
      },
      {
        "id": "single_target",
