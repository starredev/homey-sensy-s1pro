{
  "id": "io.github.starredev.sensys1pro",
  "version": "1.0.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": ["local"],
  "name": {
    "en": "Sensy S1 Pro",
    "nl": "Sensy S1 Pro"
  },
  "description": {
    "en": "mmWave presence, zones and air quality from the Sensy-One S1 Pro Multi Sense.",
    "nl": "mmWave-aanwezigheid, zones en luchtkwaliteit van de Sensy-One S1 Pro Multi Sense."
  },
  "category": ["security"],
  "brandColor": "#1D6FD8",
  "permissions": [],
  "author": {
    "name": "Bryan"
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "api": {
    "getDevices": {
      "method": "GET",
      "path": "/devices"
    },
    "getDevice": {
      "method": "GET",
      "path": "/devices/:id"
    },
    "setZone": {
      "method": "PUT",
      "path": "/devices/:id/zones/:zone"
    },
    "setZoneOptions": {
      "method": "PUT",
      "path": "/devices/:id/zones/:zone/options"
    }
  }
}
