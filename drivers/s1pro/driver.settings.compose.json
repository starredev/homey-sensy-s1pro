        "value": 0,
        "min": -50,
        "max": 50,
        "step": 0.1,
        "units": {
          "en": "°C"
        }
      },
      {
        "id": "lux_offset",
        "type": "number",
        "label": {
          "en": "Light offset",
          "nl": "Lichtcorrectie"
        },
        "value": 0,
        "min": -10000,
        "max": 10000,
        "units": {
          "en": "lx"
        },
        "step": 0.1
      },
      {
        "id": "uv_offset",
        "type": "number",
        "label": {
          "en": "UV index offset",
          "nl": "UV-indexcorrectie"
        },
        "value": 0,
        "min": -50,
        "max": 50,
        "step": 0.1
      }
    ]
