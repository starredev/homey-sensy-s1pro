ws#when","content":"The zone goes from empty to occupied."},"226":{"id":"/docs/flows-26","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#when","content":"*People* (at least 1)"},"227":{"id":"/docs/flows-27","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#when","content":"**\\[zone] became empty**"},"228":{"id":"/docs/flows-28","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#when","content":"Nobody is left in the zone (after the zone's hold time)."},"229":{"id":"/docs/flows-29","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#when","content":"**Movement started in \\[zone]**"},"230":{"id":"/docs/flows-30","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#when","content":"Someone in the zone starts moving."},"231":{"id":"/docs/flows-31","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#when","content":"**Movement stopped in \\[zone]**"},"232":{"id":"/docs/flows-32","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#when","content":"Movement in the zone stops."},"233":{"id":"/docs/flows-33","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#when","content":"**New firmware is available**"},"234":{"id":"/docs/flows-34","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#when","content":"Sensy-One released a firmware newer than the sensor runs. Fires once per version."},"235":{"id":"/docs/flows-35","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#when","content":"*Version*, *Installed version*"},"236":{"id":"/docs/flows-36","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#when","content":"When the sensor reconnects it re-sends all its values. The app does not treat those as changes, so a\nreconnect never fires *someone became present*, *zone entered* or similar cards. Zone cards also never fire\nfor zones that have no outline."},"237":{"id":"/docs/flows-37","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#and","content":"Card"},"238":{"id":"/docs/flows-38","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#and","content":"True when"},"239":{"id":"/docs/flows-39","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#and","content":"**Someone is / isn't present**"},"240":{"id":"/docs/flows-40","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#and","content":"The room is occupied (or not)."},"241":{"id":"/docs/flows-41","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#and","content":"**\\[zone] is / isn't occupied**"},"242":{"id":"/docs/flows-42","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#and","content":"Someone is inside the zone (or not). Always false for a zone without an outline."},"243":{"id":"/docs/flows-43","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#and","content":"**There is / is no movement in \\[zone]**"},"244":{"id":"/docs/flows-44","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#and","content":"Someone moves inside the zone (or not)."},"245":{"id":"/docs/flows-45","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#and","content":"**Number of people is / isn't above \\[count]**"},"246":{"id":"/docs/flows-46","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#and","content":"The people count is higher than *count* (0–3)."},"247":{"id":"/docs/flows-47","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#and","content":"**Air quality is / isn't \\[level] or worse**"},"248":{"id":"/docs/flows-48","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#and","content":"The air is at least as polluted as *level*. False until the sensor reported a class."},"249":{"id":"/docs/flows-49","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#then","content":"Card"},"250":{"id":"/docs/flows-50","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#then","content":"What it does"},"251":{"id":"/docs/flows-51","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#then","content":"**Set presence hold time of \\[zone] to \\[seconds] seconds**"},"252":{"id":"/docs/flows-52","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#then","content":"Changes the zone's hold time on the sensor (0–3600 s). Handy to make a zone \"stickier\" at night."},"253":{"id":"/docs/flows-53","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#then","content":"**Beep for \\[duration] seconds**"},"254":{"id":"/docs/flows-54","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#then","content":"Sounds the buzzer for 0.1 to 5 seconds. Pitch and volume come from the buzzer settings."},"255":{"id":"/docs/flows-55","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#examples","content":"**When** *Someone entered* **Zone 1 (desk)**"},"256":{"id":"/docs/flows-56","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#examples","content":"**And** a *Logic* card: the device's *Luminance* token is less than 50"},"257":{"id":"/docs/flows-57","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#examples","content":"**Then** turn on the desk lamp"},"258":{"id":"/docs/flows-58","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#examples","content":"And a second flow: **When** *Zone 1 became empty* **Then** turn off the desk lamp. Raise the zone's\n*presence hold time* if the lamp goes off while you are still reading."},"259":{"id":"/docs/flows-59","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#examples","content":"**When** *The CO₂ level changed* (Homey's standard card)"},"260":{"id":"/docs/flows-60","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#examples","content":"**And** a *Logic* card: the *CO₂* token is greater than 1000"},"261":{"id":"/docs/flows-61","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#examples","content":"**Then** set the ventilation to high"},"262":{"id":"/docs/flows-62","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#examples","content":"With a separate flow back to normal below 800 ppm, so it does not switch on and off around one value."},"263":{"id":"/docs/flows-63","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#examples","content":"Many ventilation systems accept external CO₂ and humidity values. Use **When** *The CO₂ level changed*\n**Then** *report the CO₂ level* with the device's *CO₂* token, and the same for humidity."},"264":{"id":"/docs/flows-64","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#examples","content":"**When** *Someone became present* **Then** bathroom light on."},"265":{"id":"/docs/flows-65","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#examples","content":"**When** *The room became empty* **Then** bathroom light off."},"266":{"id":"/docs/flows-66","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#examples","content":"In the device settings, set *Presence hold time* to a few minutes; the radar sees\npeople in the shower, but water and glass can make detection patchy."},"267":{"id":"/docs/flows-67","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#examples","content":"**When** *Air quality changed*"},"268":{"id":"/docs/flows-68","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#examples","content":"**And** *Air quality is* **Moderately polluted** *or worse*"},"269":{"id":"/docs/flows-69","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#examples","content":"**Then** send a notification: \"Air quality is now \\[Air quality], open a window.\""},"270":{"id":"/docs/flows-70","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#examples","content":"Right after the sensor started, the air quality is not calibrated yet; see\nAir quality. You can check the *Air quality calibration* token in a *Logic*\ncard if you want to skip notifications until it shows *Calibrated*."},"271":{"id":"/docs/flows-71","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#examples","content":"At 23:00: **Set presence hold time of Zone 1 (bed) to 1800 seconds**."},"272":{"id":"/docs/flows-72","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#examples","content":"At 07:00: set it back to 120 seconds."},"273":{"id":"/docs/flows-73","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#examples","content":"**When** *New firmware is available* **Then** send a notification: \"Sensy firmware \\[Version] is out\n(installed: \\[Installed version]).\""},"274":{"id":"/docs/flows-74","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#tips","content":"**Use zones rather than the room** when only part of a room matters; zone cards ignore what happens elsewhere."},"275":{"id":"/docs/flows-75","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#tips","content":"**Tune the hold times** before building complex flows; most \"light goes off while I sit still\" issues are a\nhold time that is too short."},"276":{"id":"/docs/flows-76","page_id":"/docs/flows","tags":[],"type":"text","url":"/docs/flows#tips","content":"**Combine with luminance**: the sensor's own light reading tells you whether a light is needed."},"277":{"id":"/docs","page_id":"/docs","type":"page","content":"Introduction","breadcrumbs":["Docs","Documentation","Getting started"],"tags":[],"url":"/docs"},"278":{"id":"/docs-0","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"A Homey app for the Sensy-One S1 Pro Multi Sense mmWave presence sensor."},"279":{"id":"/docs-1","page_id":"/docs","type":"heading","tags":[],"url":"/docs#what-it-does","content":"What it does"},"280":{"id":"/docs-2","page_id":"/docs","type":"heading","tags":[],"url":"/docs#get-started","content":"Get started"},"281":{"id":"/docs-3","page_id":"/docs","type":"heading","tags":[],"url":"/docs#check-the-requirements","content":"Check the requirements"},"282":{"id":"/docs-4","page_id":"/docs","type":"heading","tags":[],"url":"/docs#install-the-app-and-add-the-sensor","content":"Install the app and add the sensor"},"283":{"id":"/docs-5","page_id":"/docs","type":"heading","tags":[],"url":"/docs#draw-your-zones","content":"Draw your zones"},"284":{"id":"/docs-6","page_id":"/docs","type":"heading","tags":[],"url":"/docs#automate","content":"Automate"},"285":{"id":"/docs-7","page_id":"/docs","type":"heading","tags":[],"url":"/docs#how-it-works","content":"How it works"},"286":{"id":"/docs-8","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Sensy S1 Pro turns the Sensy-One S1 Pro Multi Sense into a\nnative Homey device: presence that also sees people who sit still, up to three zones, the number of people in the\nroom, and CO₂, air quality, temperature, humidity, pressure, light and UV."},"287":{"id":"/docs-9","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Homey talks to the sensor directly over the ESPHome native API on your local network. No Home Assistant, no MQTT\nbroker and no cloud."},"288":{"id":"/docs-10","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"This app is not made, endorsed or supported by Sensy-One. It works with the official Sensy-One firmware."},"289":{"id":"/docs-11","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-it-does","content":"Presence that stays on while you sit still, movement, and how many people are in the room."},"290":{"id":"/docs-12","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-it-does","content":"Draw up to three zones on a live radar map, each with its own presence, flows and settings."},"291":{"id":"/docs-13","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-it-does","content":"CO₂, an air quality index with a plain-language class, VOC, temperature, humidity, light and UV."},"292":{"id":"/docs-14","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-it-does","content":"A live top-down radar of the room on your dashboard."},"293":{"id":"/docs-15","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-it-does","content":"Triggers, conditions and actions for the room, every zone, air quality and new firmware."},"294":{"id":"/docs-16","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-it-does","content":"Every setting of the sensor, kept in sync in both directions."},"295":{"id":"/docs-17","page_id":"/docs","tags":[],"type":"text","url":"/docs#check-the-requirements","content":"A Homey Pro (2023) or Homey Pro mini on Homey 13 or newer, and the S1 Pro on the official firmware.\nRequirements"},"296":{"id":"/docs-18","page_id":"/docs","tags":[],"type":"text","url":"/docs#install-the-app-and-add-the-sensor","content":"Install **Sensy S1 Pro**, then add the sensor under **Devices → + → Sensy S1 Pro**.\nInstallation"},"297":{"id":"/docs-19","page_id":"/docs","tags":[],"type":"text","url":"/docs#draw-your-zones","content":"Open **Apps → Sensy S1 Pro → Configure** and draw zones while you walk through the room.\nZones"},"298":{"id":"/docs-20","page_id":"/docs","tags":[],"type":"text","url":"/docs#automate","content":"Build flows and add the radar widget to a dashboard."},"299":{"id":"/docs-21","page_id":"/docs","tags":[],"type":"text","url":"/docs#how-it-works","content":"The app is a Homey **Python** app built on\n`homey-esphomedriver`, the shared ESPHome layer that also powers\nthe generic ESPHome app for Homey. That library handles discovery, pairing, encryption, reconnects and the\nstandard capabilities. This app adds what is specific to the S1 Pro: zones, live targets, flow cards, the\nsettings mirror, the zone editor, the radar widget and firmware notices."},"300":{"id":"/docs-22","page_id":"/docs","tags":[],"type":"text","url":"/docs#how-it-works","content":"Everything runs on your local network. The only outbound request is a check for new firmware on Sensy-One's\nGitHub releases page, every six hours."},"301":{"id":"/docs/installation","page_id":"/docs/installation","type":"page","content":"Installation","breadcrumbs":["Docs","Documentation","Getting started"],"tags":[],"url":"/docs/installation"},"302":{"id":"/docs/installation-0","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation","content":"Requirements, installing the app and adding the sensor."},"303":{"id":"/docs/installation-1","page_id":"/docs/installation","type":"heading","tags":[],"url":"/docs/installation#requirements","content":"Requirements"},"304":{"id":"/docs/installation-2","page_id":"/docs/installation","type":"heading","tags":[],"url":"/docs/installation#install-the-app","content":"Install the app"},"305":{"id":"/docs/installation-3","page_id":"/docs/installation","type":"heading","tags":[],"url":"/docs/installation#add-the-sensor","content":"Add the sensor"},"306":{"id":"/docs/installation-4","page_id":"/docs/installation","type":"heading","tags":[],"url":"/docs/installation#start-adding-a-device","content":"Start adding a device"},"307":{"id":"/docs/installation-5","page_id":"/docs/installation","type":"heading","tags":[],"url":"/docs/installation#pick-your-sensor","content":"Pick your sensor"},"308":{"id":"/docs/installation-6","page_id":"/docs/installation","type":"heading","tags":[],"url":"/docs/installation#done","content":"Done"},"309":{"id":"/docs/installation-7","page_id":"/docs/installation","type":"heading","tags":[],"url":"/docs/installation#add-by-ip-address","content":"Add by IP address"},"310":{"id":"/docs/installation-8","page_id":"/docs/installation","type":"heading","tags":[],"url":"/docs/installation#encryption-key","content":"Encryption key"},"311":{"id":"/docs/installation-9","page_id":"/docs/installation","type":"heading","tags":[],"url":"/docs/installation#if-adding-fails","content":"If adding fails"},"312":{"id":"/docs/installation-10","page_id":"/docs/installation","type":"heading","tags":[],"url":"/docs/installation#change-the-address-later","content":"Change the address later"},"313":{"id":"/docs/installation-11","page_id":"/docs/installation","type":"heading","tags":[],"url":"/docs/installation#coming-from-the-previous-version","content":"Coming from the previous version"},"314":{"id":"/docs/installation-12","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#requirements","content":"**Homey**"},"315":{"id":"/docs/installation-13","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#requirements","content":"Homey Pro (2023) or Homey Pro mini"},"316":{"id":"/docs/installation-14","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#requirements","content":"**Homey firmware**"},"317":{"id":"/docs/installation-15","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#requirements","content":"13.0 or newer (the app is a Python app)"},"318":{"id":"/docs/installation-16","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#requirements","content":"**Sensor**"},"319":{"id":"/docs/installation-17","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#requirements","content":"Sensy-One S1 Pro Multi Sense, official firmware v1.2.21 or newer"},"320":{"id":"/docs/installation-18","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#requirements","content":"**Network**"},"321":{"id":"/docs/installation-19","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#requirements","content":"Homey reaches the sensor on TCP port 6053"},"322":{"id":"/docs/installation-20","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#requirements","content":"Homey Pro (Early 2019) and older, and Homey Cloud, are not supported."},"323":{"id":"/docs/installation-21","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#requirements","content":"Firmware that keeps the official entity names works as well. The app finds the sensor by its ESPHome project name,\n`Sensy-One.S1 Pro Multi Sense`, so keep that unchanged. It also understands the live target entities of the\nearlier \"Homey edition\" firmware (`live_t1_x` and so on). Features that need entities a custom build left out\nsimply stay empty."},"324":{"id":"/docs/installation-22","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#requirements","content":"Automatic discovery uses mDNS (`_esphomelib._tcp`), which does not cross networks or VLANs. If the sensor lives on\na separate IoT network, add it by IP address and give it a fixed IP address (a DHCP\nreservation in your router)."},"325":{"id":"/docs/installation-23","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#requirements","content":"Everything stays on your local network. Only the firmware notice needs\ninternet access, to check `github.com` for new releases."},"326":{"id":"/docs/installation-24","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#requirements","content":"The official firmware has a Bluetooth proxy for Home Assistant (**BLE | Proxy** on the sensor's web page). The\nESP32-C3 shares one radio between WiFi and Bluetooth, and with the proxy on the connection to Homey drops\nregularly. The app shows a warning on the device while it is on."},"327":{"id":"/docs/installation-25","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#install-the-app","content":"Open the app's page in the Homey App Store and choose **Install**. While the app is in testing, use the test link\nfrom the project page. Updates arrive through the App Store."},"328":{"id":"/docs/installation-26","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#install-the-app","content":"You need Node.js 22, the Homey CLI and\nDocker, which compiles the app's Python dependencies."},"329":{"id":"/docs/installation-27","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#install-the-app","content":"On Windows, see the Windows notes if the CLI fails with *Error while\ncollecting cross-compiled virtual environment*."},"330":{"id":"/docs/installation-28","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#start-adding-a-device","content":"In the Homey app, go to **Devices → +**, choose **Sensy S1 Pro**, then **S1 Pro Multi Sense**."},"331":{"id":"/docs/installation-29","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#pick-your-sensor","content":"Homey lists the S1 Pro sensors it found on your network that are not added yet. Pick yours. Not in the list?\nChoose **Add by IP…** (see below)."},"332":{"id":"/docs/installation-30","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#done","content":"Homey connects, reads the sensor and adds the device, named as the sensor reports itself (for example\n*S1 Pro Multi Sense 2cd9f0*). Move it to the room it hangs in, so Homey's zone activity follows it."},"333":{"id":"/docs/installation-31","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#done","content":"Right after adding, the app reads everything from the sensor: the device values, all\nsettings, and the zones that are already drawn, which get their own capabilities a few seconds\nlater."},"334":{"id":"/docs/installation-32","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#add-by-ip-address","content":"Use **Add by IP…** when the sensor is not found automatically."},"335":{"id":"/docs/installation-33","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#add-by-ip-address","content":"Enter the sensor's **IP address or host name**, for example `192.168.1.40` or `s1-pro-multi-sense-2cd9f0.local`."},"336":{"id":"/docs/installation-34","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#add-by-ip-address","content":"Leave the **port** at `6053` unless you changed it in the firmware."},"337":{"id":"/docs/installation-35","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#add-by-ip-address","content":"Choose **Connect**."},"338":{"id":"/docs/installation-36","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#add-by-ip-address","content":"You find the IP address in your router or on the sensor's web page. A sensor added this way is still recognised by\nits MAC address, so if mDNS later sees it at another address, Homey follows it."},"339":{"id":"/docs/installation-37","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#encryption-key","content":"If the firmware has an API encryption key (`api: encryption: key:` in ESPHome), Homey asks for it after\nconnecting. The official firmware has no key, so normally you will not see this step."},"340":{"id":"/docs/installation-38","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#if-adding-fails","content":"Message"},"341":{"id":"/docs/installation-39","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#if-adding-fails","content":"Cause"},"342":{"id":"/docs/installation-40","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#if-adding-fails","content":"*This ESPHome project is not supported by this Homey app.*"},"343":{"id":"/docs/installation-41","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#if-adding-fails","content":"Another ESPHome device answered, or the firmware's project name is not `Sensy-One.S1 Pro Multi Sense`."},"344":{"id":"/docs/installation-42","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#if-adding-fails","content":"*Could not connect to the ESPHome device…*"},"345":{"id":"/docs/installation-43","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#if-adding-fails","content":"Nothing answered on port 6053. Check the address, power and network."},"346":{"id":"/docs/installation-44","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#if-adding-fails","content":"*The device did not respond in time.*"},"347":{"id":"/docs/installation-45","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#if-adding-fails","content":"The sensor is busy or the network is slow. Try again."},"348":{"id":"/docs/installation-46","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#if-adding-fails","content":"*The encryption key is invalid.*"},"349":{"id":"/docs/installation-47","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#if-adding-fails","content":"The key does not match the firmware."},"350":{"id":"/docs/installation-48","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#if-adding-fails","content":"*This device is not using encryption.*"},"351":{"id":"/docs/installation-49","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#if-adding-fails","content":"You entered a key, but the firmware has none."},"352":{"id":"/docs/installation-50","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#change-the-address-later","content":"If the sensor got a new IP address that Homey does not pick up by itself, or you added an encryption key, open\nthe device's settings and choose **Repair**. The device, its flows and Insights are kept."},"353":{"id":"/docs/installation-51","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#coming-from-the-previous-version","content":"Earlier versions of this app were written in Node.js and had the app id `io.github.starredev.sensys1pro`. The\ncurrent app (`io.github.starredev.sensy`) installs **next to** it."},"354":{"id":"/docs/installation-52","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#coming-from-the-previous-version","content":"Install the new app and add the sensor (both apps can be connected at the same time)."},"355":{"id":"/docs/installation-53","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#coming-from-the-previous-version","content":"Move your flows to the new device. Presence is now `alarm_presence` (was `alarm_motion`), movement is now\n`alarm_motion` (was `sensy_moving`). The app's own flow cards kept their names."},"356":{"id":"/docs/installation-54","page_id":"/docs/installation","tags":[],"type":"text","url":"/docs/installation#coming-from-the-previous-version","content":"Remove the old device and the old app."},"357":{"id":"/docs/maintenance","page_id":"/docs/maintenance","type":"page","content":"Maintenance and firmware","breadcrumbs":["Docs","Documentation","Configuration"],"tags":[],"url":"/docs/maintenance"},"358":{"id":"/docs/maintenance-0","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance","content":"Maintenance actions, firmware notices and extra capabilities."},"359":{"id":"/docs/maintenance-1","page_id":"/docs/maintenance","type":"heading","tags":[],"url":"/docs/maintenance#maintenance-actions","content":"Maintenance actions"},"360":{"id":"/docs/maintenance-2","page_id":"/docs/maintenance","type":"heading","tags":[],"url":"/docs/maintenance#calibrate-co-sensor","content":"Calibrate CO₂ sensor"},"361":{"id":"/docs/maintenance-3","page_id":"/docs/maintenance","type":"heading","tags":[],"url":"/docs/maintenance#restart-sensor","content":"Restart sensor"},"362":{"id":"/docs/maintenance-4","page_id":"/docs/maintenance","type":"heading","tags":[],"url":"/docs/maintenance#restart-radar","content":"Restart radar"},"363":{"id":"/docs/maintenance-5","page_id":"/docs/maintenance","type":"heading","tags":[],"url":"/docs/maintenance#refresh-capabilities","content":"Refresh capabilities"},"364":{"id":"/docs/maintenance-6","page_id":"/docs/maintenance","type":"heading","tags":[],"url":"/docs/maintenance#firmware-updates","content":"Firmware updates"},"365":{"id":"/docs/maintenance-7","page_id":"/docs/maintenance","type":"heading","tags":[],"url":"/docs/maintenance#extra-capabilities","content":"Extra capabilities"},"366":{"id":"/docs/maintenance-8","page_id":"/docs/maintenance","type":"heading","tags":[],"url":"/docs/maintenance#factory-resets","content":"Factory resets"},"367":{"id":"/docs/maintenance-9","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#maintenance-actions","content":"Open the device and find the maintenance actions (in the device's settings, under *Maintenance*)."},"368":{"id":"/docs/maintenance-10","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#calibrate-co-sensor","content":"Sets the SCD40's CO₂ reading to **426 ppm**, the CO₂ level of outdoor air (forced recalibration)."},"369":{"id":"/docs/maintenance-11","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#calibrate-co-sensor","content":"The calibration assumes the sensor is in outdoor air **right now**. Put the sensor outside (or at a wide\nopen window with a breeze) for **at least 3 minutes** first, without people breathing nearby. Calibrating\nindoors makes every later reading wrong."},"370":{"id":"/docs/maintenance-12","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#calibrate-co-sensor","content":"Use it when the CO₂ readings have drifted, for example when they stay well above 420 ppm while the room is\nthoroughly aired. The firmware does not recalibrate the sensor by itself."},"371":{"id":"/docs/maintenance-13","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#restart-sensor","content":"Restarts the sensor's ESP32. The device is unavailable for a few seconds and reconnects by itself. Zones and\nsettings are kept: they are stored on the sensor."},"372":{"id":"/docs/maintenance-14","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#restart-radar","content":"Restarts only the radar module. Use it when the radar stops reporting people while the rest of the sensor\nworks."},"373":{"id":"/docs/maintenance-15","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#refresh-capabilities","content":"Rebuilds the device's capabilities from what the sensor reports. You rarely need it:"},"374":{"id":"/docs/maintenance-16","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#refresh-capabilities","content":"capabilities for newly drawn zones appear by themselves;"},"375":{"id":"/docs/maintenance-17","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#refresh-capabilities","content":"after an app update that adds capabilities, the device refreshes once by itself."},"376":{"id":"/docs/maintenance-18","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#refresh-capabilities","content":"Use it after a firmware update that added new entities, if they do not show up. Your zone capabilities are kept."},"377":{"id":"/docs/maintenance-19","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#firmware-updates","content":"The app checks the Sensy-One releases on GitHub\nwhen the sensor connects and then every six hours. When a newer version than the one on your sensor is out:"},"378":{"id":"/docs/maintenance-20","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#firmware-updates","content":"the device shows a warning: *Firmware vX is available (installed: vY). Update the sensor from its web page.*;"},"379":{"id":"/docs/maintenance-21","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#firmware-updates","content":"the *New firmware is available* trigger fires, once per version."},"380":{"id":"/docs/maintenance-22","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#firmware-updates","content":"The app does **not** install updates itself. Update the sensor from its own web page:"},"381":{"id":"/docs/maintenance-23","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#firmware-updates","content":"Open the sensor's web page (its address is in the device settings under *Web server*, or\n`http://<sensor-ip>/`)."},"382":{"id":"/docs/maintenance-24","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#firmware-updates","content":"Use the firmware update there, following Sensy-One's instructions."},"383":{"id":"/docs/maintenance-25","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#firmware-updates","content":"The warning disappears as soon as the sensor reconnects with the new version."},"384":{"id":"/docs/maintenance-26","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#firmware-updates","content":"The firmware can check GitHub itself, but the HTTPS request needs a lot of memory on the ESP32-C3 and rarely\ngets an answer. Homey checks instead and only compares version numbers; nothing about your sensor is sent."},"385":{"id":"/docs/maintenance-27","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"Two switches in the device settings, under *Capabilities*, add more of the sensor's entities to the device:"},"386":{"id":"/docs/maintenance-28","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"Capability"},"387":{"id":"/docs/maintenance-29","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"From the sensor"},"388":{"id":"/docs/maintenance-30","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"Connectivity"},"389":{"id":"/docs/maintenance-31","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"ESP32 status"},"390":{"id":"/docs/maintenance-32","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"Temperature (ESP32)"},"391":{"id":"/docs/maintenance-33","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"Chip temperature"},"392":{"id":"/docs/maintenance-34","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"IP address"},"393":{"id":"/docs/maintenance-35","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"ESP32 IP"},"394":{"id":"/docs/maintenance-36","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"WiFi network"},"395":{"id":"/docs/maintenance-37","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"ESP32 SSID"},"396":{"id":"/docs/maintenance-38","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"WiFi strength"},"397":{"id":"/docs/maintenance-39","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"*Very weak* … *Very strong*"},"398":{"id":"/docs/maintenance-40","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"Capability"},"399":{"id":"/docs/maintenance-41","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"From the sensor"},"400":{"id":"/docs/maintenance-42","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"On/off, brightness, colour, effect"},"401":{"id":"/docs/maintenance-43","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"The RGB status LED (WS2812)"},"402":{"id":"/docs/maintenance-44","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"BLE proxy"},"403":{"id":"/docs/maintenance-45","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"Bluetooth proxy for Home Assistant (keep it off)"},"404":{"id":"/docs/maintenance-46","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"Buzzer"},"405":{"id":"/docs/maintenance-47","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"The buzzer as a switch"},"406":{"id":"/docs/maintenance-48","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"Radar Bluetooth"},"407":{"id":"/docs/maintenance-49","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"The radar module's own Bluetooth"},"408":{"id":"/docs/maintenance-50","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#extra-capabilities","content":"Turning a switch off removes those capabilities again. Settings that already have a place in the\ndevice settings (single target, mirrored mounting, real-time readings, holding engine, tracking\nnumbers, offsets, buzzer pitch and volume) and the factory reset buttons are never added as capabilities."},"409":{"id":"/docs/maintenance-51","page_id":"/docs/maintenance","tags":[],"type":"text","url":"/docs/maintenance#factory-resets","content":"The sensor has factory reset buttons for the ESP32, the radar and the CO₂ sensor. The app deliberately does not\noffer them: one tap would wipe your sensor's WiFi, zones or calibration. Use the sensor's own web page if you\nreally need them."},"410":{"id":"/docs/placement","page_id":"/docs/placement","type":"page","content":"Placing the sensor","breadcrumbs":["Docs","Documentation","Getting started"],"tags":[],"url":"/docs/placement"},"411":{"id":"/docs/placement-0","page_id":"/docs/placement","tags":[],"type":"text","url":"/docs/placement","content":"Mount the S1 Pro so the radar sees the room well, and understand its coordinates."},"412":{"id":"/docs/placement-1","page_id":"/docs/placement","type":"heading","tags":[],"url":"/docs/placement#the-coordinate-system","content":"The coordinate system"},"413":{"id":"/docs/placement-2","page_id":"/docs/placement","type":"heading","tags":[],"url":"/docs/placement#tips","content":"Tips"},"414":{"id":"/docs/placement-3","page_id":"/docs/placement","type":"heading","tags":[],"url":"/docs/placement#checking-the-result","content":"Checking the result"},"415":{"id":"/docs/placement-4","page_id":"/docs/placement","tags":[],"type":"text","url":"/docs/placement","content":"The S1 Pro's mmWave radar sees a **fan-shaped area of about 120°** in front of the sensor. Placement decides\nhow well it detects people, and where your zones end up."},"416":{"id":"/docs/placement-5","page_id":"/docs/placement","tags":[],"type":"text","url":"/docs/placement#the-coordinate-system","content":"The app, the zone editor and the radar widget all use the radar's own coordinates, in centimetres:"},"417":{"id":"/docs/placement-6","page_id":"/docs/placement","tags":[],"type":"text","url":"/docs/placement#the-coordinate-system","content":"**x** is left (−) or right (+) as seen *from* the sensor."},"418":{"id":"/docs/placement-7","page_id":"/docs/placement","tags":[],"type":"text","url":"/docs/placement#the-coordinate-system","content":"**y** is the distance straight in front of the sensor."},"419":{"id":"/docs/placement-8","page_id":"/docs/placement","tags":[],"type":"text","url":"/docs/placement#the-coordinate-system","content":"The **detection range** (default 600 cm, see settings) limits how far the\nradar looks."},"420":{"id":"/docs/placement-9","page_id":"/docs/placement","tags":[],"type":"text","url":"/docs/placement#tips","content":"**Face the open room.** Mount the sensor so the area you care about is in front of it, not at the far edge of\nthe field of view."},"421":{"id":"/docs/placement-10","page_id":"/docs/placement","tags":[],"type":"text","url":"/docs/placement#tips","content":"**Avoid moving objects in view**: fans, curtains in a draught, plants near a heater, robot vacuums. Hide them\nwith an exclusion zone if you cannot avoid them."},"422":{"id":"/docs/placement-11","page_id":"/docs/placement","tags":[],"type":"text","url":"/docs/placement#tips","content":"**Be careful with mirrors, glass and tiles.** Radar signals reflect off hard, flat surfaces. A person can then\nshow up twice: once where they are and once as a \"mirror image\" that moves along. Bathrooms with large\nmirrors or a glass shower wall are the worst case. See ghost targets."},"423":{"id":"/docs/placement-12","page_id":"/docs/placement","tags":[],"type":"text","url":"/docs/placement#tips","content":"**Pets are seen too.** A cat or dog is a moving target like any other. Zones and the\npeople count condition help to tell a person from a pet in most rooms."},"424":{"id":"/docs/placement-13","page_id":"/docs/placement","tags":[],"type":"text","url":"/docs/placement#tips","content":"**Upside down or facing the other way?** Turn on *Mirrored mounting* so left\nand right are not swapped in your zones and on the radar."},"425":{"id":"/docs/placement-14","page_id":"/docs/placement","tags":[],"type":"text","url":"/docs/placement#tips","content":"For mounting height, angle and the sensor's exact range, follow the instructions that came with the sensor\nand the Sensy-One documentation."},"426":{"id":"/docs/placement-15","page_id":"/docs/placement","tags":[],"type":"text","url":"/docs/placement#checking-the-result","content":"Open the zone editor (**Apps → Sensy S1 Pro → Configure**) and walk around the room. You\nsee yourself as a dot on the radar map. If the dot follows you well everywhere you want to detect people, the\nsensor is placed right."},"427":{"id":"/docs/reference/capabilities","page_id":"/docs/reference/capabilities","type":"page","content":"Capabilities","breadcrumbs":["Docs","Documentation","Reference"],"tags":[],"url":"/docs/reference/capabilities"},"428":{"id":"/docs/reference/capabilities-0","page_id":"/docs/reference/capabilities","tags":[],"type":"text","url":"/docs/reference/capabilities","content":"Every capability id, its type, units and source entity."},"429":{"id":"/docs/reference/capabilities-1","page_id":"/docs/reference/capabilities","type":"heading","tags":[],"url":"/docs/reference/capabilities#always-present","content":"Always present"},"430":{"id":"/docs/reference/capabilities-2","page_id":"/docs/reference/capabilities","type":"heading","tags":[],"url":"/docs/reference/capabilities#enum-values","content":"Enum values"},"431":{"id":"/docs/reference/capabilities-3","page_id":"/docs/reference/capabilities","type":"heading","tags":[],"url":"/docs/reference/capabilities#per-drawn-zone","content":"Per drawn zone"},"432":{"id":"/docs/reference/capabilities-4","page_id":"/docs/reference/capabilities","type":"heading","tags":[],"url":"/docs/reference/capabilities#maintenance-actions","content":"Maintenance actions"},"433":{"id":"/docs/reference/capabilities-5","page_id":"/docs/reference/capabilities","type":"heading","tags":[],"url":"/docs/reference/capabilities#optional","content":"Optional"},"434":{"id":"/docs/reference/capabilities-6","page_id":"/docs/reference/capabilities","type":"heading","tags":[],"url":"/docs/reference/capabilities#custom-capability-definitions","content":"Custom capability definitions"},"435":{"id":"/docs/reference/capabilities-7","page_id":"/docs/reference/capabilities","tags":[]