{
  "name": "io.github.starredev.sensys1pro",
  "version": "1.0.0",
  "description": "Browser tooling (lint, tests) for the web views of the Sensy S1 Pro Homey app; the app itself is Python.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Bryan",
  "repository": {
    "type": "git",
    "url": "https://github.com/starredev/homey-sensy-s1pro.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"widgets/radar/public/lib/*.js\" --test-coverage-lines=85 --test-coverage-branches=80 --test-coverage-functions=85 \"test/*.test.js\"",
    "check": "npm run lint && npm run test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^65.1.0",
    "globals": "^17.13.0"
  }
}
